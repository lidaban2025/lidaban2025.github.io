{
  "name": "FormCopy redirect",
  "kind": "zone",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "action": "redirect",
      "expression": "(http.host in {\"formsuite.dev\" \"www.formsuite.dev\"}) and (http.request.uri.path eq \"/formcopy\" or starts_with(http.request.uri.path, \"/formcopy/\"))",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "value": "https://formsuite.dev/"
          }
        }
      }
    }
  ]
}
